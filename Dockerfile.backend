# Build stage
FROM golang:1.19.1 AS builder

WORKDIR /app

# Copy go mod and sum files
COPY go.mod go.sum ./
RUN go mod download

# Copy source code
COPY . .

# Build the application
RUN CGO_ENABLED=1 GOOS=linux go build -a -o webapi ./cmd/webapi

# Final stage
FROM debian:stable-slim

WORKDIR /app

# Copy binary from builder
COPY --from=builder /app/webapi .

# Expose port (default 3000)
EXPOSE 3000

# Run
CMD ["./webapi"]
